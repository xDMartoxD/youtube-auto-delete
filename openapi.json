    "/v1/youtube/playlists/{playlist_id}/videos": {
      "get": {
        "tags": [
          "youtube"
        ],
        "summary": "Get Playlist Videos",
        "description": "Get videos from a YouTube playlist with pagination and optional date filtering.\n\n- **max_results**: Número máximo de resultados por página (1-50)\n- **page_token**: Token de página para paginación\n- **date_from**: Filtrar videos agregados a la playlist desde esta fecha (ISO 8601)\n- **date_to**: Filtrar videos agregados a la playlist hasta esta fecha (ISO 8601)",
        "operationId": "get_playlist_videos_v1_youtube_playlists__playlist_id__videos_get",
        "security": [
          {
            "Session Cookie": []
          }
        ],
        "parameters": [
          {
            "name": "playlist_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Playlist Id"
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Número máximo de resultados por página",
              "default": 25,
              "title": "Max Results"
            },
            "description": "Número máximo de resultados por página"
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Token de página para paginación",
              "title": "Page Token"
            },
            "description": "Token de página para paginación"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fecha de inicio (ISO 8601). Filtra videos agregados desde esta fecha.",
              "title": "Date From"
            },
            "description": "Fecha de inicio (ISO 8601). Filtra videos agregados desde esta fecha."
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fecha de fin (ISO 8601). Filtra videos agregados hasta esta fecha.",
              "title": "Date To"
