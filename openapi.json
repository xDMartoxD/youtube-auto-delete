    "/v1/auth/exchange": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Code Login",
        "description": "Intercambia un código de autorización de Google por tokens y crea una sesión.\n\n- **code**: Código de autorización obtenido de Google OAuth\n- **redirect_uri**: URI de redirección registrada en Google Console\n\nRetorna información del usuario autenticado y establece una cookie de sesión.",
        "operationId": "code_login_v1_auth_exchange_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleCodeLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSuccessResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
