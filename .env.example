# App
APP_ENV=dev
LOG_LEVEL=INFO
# CORS_ORIGINS: defaults to the localhost dev origins; never "*" (cookies need an explicit origin)

# DynamoDB (local container from docker-compose.dev.yaml; dummy credentials are fine locally)
TABLE_NAME=youtube-delete-app
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# JWT
JWT_SECRET=change_me

# Redis/Valkey
REDIS_HOST=valkey
REDIS_PORT=6379

# Spotify (optional; without it Spotify stays in demo mode)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/v1/providers/spotify/callback
FRONTEND_URL=http://localhost:5173
