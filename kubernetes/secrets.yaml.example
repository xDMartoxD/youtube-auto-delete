# SECRETS - NO COMMIT THIS FILE TO GIT!
# Create this file manually with your actual secrets
# Use: kubectl create secret generic youtube-auto-delete-secrets --from-file=secrets.yaml
# Or: kubectl apply -f secrets.yaml (after encoding values in base64)

apiVersion: v1
kind: Secret
metadata:
    name: youtube-auto-delete-secrets
    namespace: default
type: Opaque
stringData:
    # Google OAuth Configuration
    google_client_id: "1045602413659-ns6cq27oi7ro1vj9pd9m8biq7q59j259.apps.googleusercontent.com"
    google_client_secret: "***REMOVED***"

    # JWT Configuration
    jwt_secret: "your-jwt-secret-key-here"

    # Redis/ElastiCache Configuration
    # Format: rediss://[password@]host:port (for TLS) or redis://[password@]host:port
    # Example with password: rediss://:mypassword@your-cache.cache.amazonaws.com:6379
    # Example without password: rediss://youtube-auto-delete-cache-u4q3ql.serverless.use1.cache.amazonaws.com:6379
    redis_url: "rediss://youtube-auto-delete-cache-u4q3ql.serverless.use1.cache.amazonaws.com:6379"

